%% VM Portal - Request and Lifecycle Workflow (v2)
%% Green = added or changed vs v1. Yellow = sub-process (see linked diagram).
%% All VM work (create, power off, power on, delete) is done by hand in the vCloud dashboard; the portal records it.
flowchart TD
    Start(["Employee opens portal"]) --> Auth[["Login + session check<br/>(Diagram 3)"]]
    Auth --> Role{"Identify user role"}
    Role -->|End User| EUD["End-User Dashboard"]
    Role -->|Manager| MD["Manager Dashboard"]
    Role -->|vCloud Admin| VD["vCloud Operations Dashboard"]

    %% ---------- Request creation ----------
    EUD --> NewReq["Create New VM Request"]
    MD --> ForEmp["Create VM Request<br/>for self or team member"]
    NewReq --> Req["Enter business and technical requirements"]
    ForEmp --> Req
    Req --> Valid{"Request information valid?"}
    Valid -->|No| ValErr["Show validation errors"] --> Req
    Valid -->|Yes| Submit["Submit Request<br/>Status: SUBMITTED"]
    Submit -.->|"Requester cancels before decision"| Cancel["Status: CANCELLED"] --> Closed1(["Request Closed"])
    Submit --> Appr1[["Approval Routing + Escalation<br/>(Diagram 2)"]]
    Appr1 -->|"Returned for correction"| Corr["Category, comment, fields to update,<br/>resubmit-by date<br/>Status: RETURNED - Needs correction"] --> Upd["Requester updates request"] --> Submit
    Appr1 -->|"Rejected or timed out"| Rej["Category + comment<br/>Status: REJECTED<br/>Rejection email to requester"] --> Closed1
    Appr1 -->|Approved| Approved["Status: APPROVED"]

    %% ---------- Manual VM creation by vCloud admins ----------
    Approved --> Kind{"New VM or existing VM?"}
    Kind -->|"Existing VM offered by approver"| HQueue["Handover task in vCloud queue<br/>Current owner notified"]
    HQueue --> Reset["vCloud admin resets access by hand<br/>in the vCloud dashboard"]
    Reset --> Handed["Ownership moves to requester<br/>E = handover date + lease<br/>Status: COMPLETED"]
    Handed --> Active
    Kind -->|"New VM"| Queue["Add to vCloud creation queue<br/>Notify vCloud team"]
    VD -.->|"works the queue"| Queue
    Queue --> Assign["Assign request to engineer"]
    Assign --> Feas["Technical and capacity validation"]
    Feas --> FeasD{"Can it be created?"}
    FeasD -->|"More information required"| MoreInfo["Request additional information<br/>Notify requester and manager"] --> InfoGiven["Requester provides information"] --> Feas
    FeasD -->|No| TechRej["Record failure category,<br/>resources short, details"] --> NotifyFail["Notify requester and manager"] --> Closed2(["Request Closed"])
    FeasD -->|Yes| CStart["Engineer marks it started<br/>Status: CREATION_IN_PROGRESS"]
    CStart --> Manual["Engineer creates the VM by hand<br/>in the vCloud dashboard"]
    Manual --> Created{"VM created?"}
    Created -->|"Not yet: waiting on capacity or network"| Hold["On hold: reason + expected date<br/>Requester notified"] --> Manual
    Created -->|"No: cannot be created"| TechRej
    Created -->|Yes| Record["Engineer enters VM details in the portal<br/>hostname, IP, specs, actual creation date"]
    Record --> SetExp["Set owner and expiry<br/>E = actual creation date + lease"]
    SetExp --> Active["Status: ACTIVE<br/>Notify requester and manager<br/>VM visible in My VMs"]

    %% ---------- Expiry monitoring ----------
    Active --> Monitor["Daily lifecycle job"]
    Monitor --> Due{"Notice due today?<br/>E-10 / E-3 / E-1"}
    Due -->|No| ExpD{"Expiry date reached?"}
    ExpD -->|No| Monitor
    Due -->|Yes| Notice["Send expiry notice<br/>Extend / Release links - login required"]
    Notice --> Act{"Employee action"}
    Act -->|"No response"| ExpD
    ExpD -->|Yes| Expired["Status: EXPIRED<br/>Power-off task for vCloud team<br/>done by hand in the dashboard"]
    Expired --> Grace["Grace notices at E+5 and E+10<br/>CC manager"]
    Grace --> GraceAct{"Employee action during grace"}
    GraceAct -->|"No response"| Final["E+15: final notice<br/>Auto-create deletion request"]

    %% ---------- Extension ----------
    Act -->|"Request extension"| ExtForm["Enter extension period and reason<br/>Status: EXTENSION_PENDING<br/>Notices paused, VM left as-is"]
    GraceAct -->|"Request extension"| ExtForm
    ExtForm --> Appr2[["Approval Routing + Escalation<br/>(Diagram 2)"]]
    Appr2 -->|"Rejected or timed out"| ExtRej["Notify employee and manager"]
    Appr2 -->|Approved| ExtVal["vCloud team validates extension"]
    ExtVal --> ExtOK{"Extension allowed?"}
    ExtOK -->|No| ExtTechRej["Reject with technical reason"] --> ExtRej
    ExtRej --> Resume["Notices resume on original expiry<br/>Deletion no earlier than rejection + 5 days"] --> Monitor
    ExtOK -->|Yes| ExtUpd["New expiry = old expiry + extension<br/>Cycle + 1, notices resume<br/>If in grace: admin powers it back on<br/>Record extension history"]
    ExtUpd --> ExtNotify["Notify employee and manager"] --> Monitor

    %% ---------- Release and deletion ----------
    Act -->|"No longer required"| Confirm["Warning: VM and all data permanently deleted<br/>User types hostname to confirm"]
    GraceAct -->|"No longer required"| Confirm
    Confirm --> DelReq["Create deletion request<br/>Status: PENDING_DELETION<br/>Show deletion ETA"]
    Final --> DelReq
    DelReq --> DelQueue["Deletion queue<br/>Notify vCloud team"]
    VD -.->|"works the queue"| DelQueue
    DelQueue --> RetD{"Data retention required by policy?"}
    RetD -->|Yes| Archive["Archive data per retention policy"] --> Delete
    RetD -->|No| Delete["vCloud admin powers off and deletes<br/>the VM by hand in the dashboard"]
    Delete --> Decom["Admin marks it deleted in the portal<br/>Status: DELETED<br/>Record actual deletion date vs ETA<br/>Notify employee and manager"]
    Decom --> Done(["VM Lifecycle Completed"])

    classDef new fill:#dff5e3,stroke:#2e7d32,color:#1b3d20
    classDef sub fill:#fff4d6,stroke:#b7791f,color:#5c3d00
    class Auth,Appr1,Appr2 sub
    class Kind,HQueue,Reset,Handed,Hold,TechRej,Corr,Rej,CStart,Manual,Created,Record,ForEmp,Cancel,Monitor,Due,Notice,Expired,Grace,GraceAct,Final,ExtForm,ExtRej,Resume,ExtUpd,Confirm,DelReq,RetD,Decom new
