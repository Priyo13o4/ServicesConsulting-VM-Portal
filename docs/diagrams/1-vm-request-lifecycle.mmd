%% VM Portal - Request and Lifecycle Workflow (v3)
%% All VM work (create, power off, revert, delete) is done by hand in the vCloud dashboard; the portal records it.
%% Yellow = sub-process in another diagram. Blue = Phase 2.
flowchart TD
    Start(["Employee opens portal"]) --> Auth[["Login + session check<br/>(Diagram 3)"]]
    Auth --> Role{"Identify user role"}
    Role -->|End User| EUD["End-User Dashboard"]
    Role -->|Manager| MD["Manager Dashboard"]
    Role -->|vCloud Admin| VD[["vCloud Admin Queue<br/>(Diagram 5)"]]

    %% ---------- Request ----------
    EUD --> Req["Fill request form<br/>reason, project, customer, product stack,<br/>number of VMs, vApp, OS, CPU, RAM, storage,<br/>backup owner, optional custom credentials"]
    MD --> ForEmp["Request for self or a team member"] --> Req
    Req --> Valid{"Form valid?"}
    Valid -->|No| ValErr["Show validation errors"] --> Req
    Valid -->|Yes| Submit["Submit<br/>Status: SUBMITTED"]
    Submit -.->|"Requester cancels before decision"| Cancel["Status: CANCELLED"] --> Closed1(["Request closed"])
    Submit --> Appr1[["Approval routing + urgent follow-up<br/>(Diagram 2)"]]
    Appr1 -->|"Returned for correction"| Corr["Category, comment, fields to update,<br/>resubmit-by date<br/>Status: RETURNED - Needs correction"] --> Upd["Requester updates request"] --> Submit
    Appr1 -->|"Rejected or timed out"| Rej["Category + comment<br/>Status: REJECTED<br/>Rejection email"] --> Closed1
    Appr1 -->|"Approved, or approved on behalf<br/>by a vCloud admin"| Approved["Status: APPROVED"]

    %% ---------- Manual creation ----------
    Approved --> Kind{"New VMs or existing VM?"}
    Kind -->|"Existing VM offered by approver"| HQ["Handover item in admin queue"]
    HQ --> Reset["Admin resets access by hand<br/>and records new credentials"]
    Reset --> Handed["Requester becomes owner<br/>expiry = handover date + approved duration<br/>Status: COMPLETED"]
    Handed --> Active
    Kind -->|"New VMs"| Queue["Create item in admin queue"]
    VD -.->|"Assign to me"| Queue
    Queue --> CStart["Admin marks it started<br/>Status: CREATION_IN_PROGRESS"]
    CStart --> Manual["Admin creates the VMs by hand<br/>in the vCloud dashboard, inside a vApp"]
    Manual --> Created{"VMs created?"}
    Created -->|"No, e.g. storage full"| TechRej["Reject with comment<br/>Status: REJECTED"] --> Closed2(["Request closed"])
    Created -->|Yes| Record["Admin records per VM: vApp, IP, OS, specs,<br/>creation date, username, password<br/>defaults: Administrator or root + default password"]
    Record --> Active["Status: COMPLETED<br/>VMs ACTIVE, expiry = creation date + approved duration<br/>VM-ready email: IP, username, link"]

    %% ---------- Lease lifecycle (Phase 2) ----------
    Active --> Monitor["Daily lifecycle job"]
    Monitor --> Due{"Notice due?<br/>E-10 / E-3 / E-1"}
    Due -->|Yes| Notice["Notice to owner + backup owner:<br/>extend or release"] --> Act{"Owner action"}
    Due -->|No| EDay{"Expiry date reached?"}
    Act -->|"No response"| EDay
    EDay -->|No| Monitor
    EDay -->|Yes| Expired["Status: EXPIRED<br/>Power-off task: admin powers it off by hand"]
    Expired --> Grace["Grace notices at E+5, E+10<br/>manager copied"]
    Grace --> GAct{"Owner action during grace"}
    GAct -->|"No response by E+15"| Final["Final notice: permanently deleted,<br/>no archive<br/>DELETE request created"]

    Act -->|Extend| ExtReq["EXTEND request: days + reason<br/>Status: EXTENSION_PENDING<br/>notices paused"]
    GAct -->|Extend| ExtReq
    ExtReq --> Appr2[["Approval routing<br/>(Diagram 2)"]]
    Appr2 -->|Approved| ExtDo["Admin checks capacity, updates the VM<br/>in the dashboard, powers it on if expired"]
    ExtDo --> NewE["Status: ACTIVE<br/>new expiry = old expiry + extension"] --> Monitor
    Appr2 -->|"Rejected or timed out"| ExtRej["Owner notified, schedule resumes on original expiry<br/>deletion no earlier than rejection + 5 days"] --> Monitor

    Act -->|Release| Confirm["Owner types the IP to confirm:<br/>permanent deletion, no archive"]
    GAct -->|Release| Confirm
    Confirm --> DelReq["DELETE request with ETA<br/>Status: PENDING_DELETION"]
    Final --> DelReq
    DelReq --> DQ["Delete item in admin queue"]
    DQ --> HardDel["Admin hard-deletes the VM by hand<br/>in the vCloud dashboard"]
    HardDel --> Deleted["Status: DELETED<br/>owner, backup owner, manager notified"] --> Done(["VM lifecycle complete"])

    classDef sub fill:#fff4d6,stroke:#b7791f,color:#5c3d00
    classDef p2 fill:#e3eefc,stroke:#3b6db3,color:#14325e
    class Auth,Appr1,Appr2,VD sub
    class Monitor,Due,Notice,Act,EDay,Expired,Grace,GAct,Final,ExtReq,ExtDo,NewE,ExtRej,Confirm,DelReq,DQ,HardDel,Deleted p2
