# Copy to .env.local (local + smoke) or .env.deploy (dev and prod servers).
# The same file feeds Docker Compose ${...} substitution and the app container.
# Comments stay on their own lines.

# Database. Keep the password URL-safe (letters, digits, - and _).
POSTGRES_DB=vm_portal
POSTGRES_USER=vm_portal
POSTGRES_PASSWORD=change-me-local

# Auth. Secret: run `openssl rand -base64 32`.
# URL: http://localhost:3000 locally, https://<internal hostname> on servers.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email. Local and smoke use Mailpit (host mailpit, port 1025). Servers use the internal relay.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VM Portal <vm-portal@example.internal>

# Comma-separated company email domains allowed to register (open question Q12).
ALLOWED_EMAIL_DOMAINS=example.com

# Keeps server actions valid across restarts. Run `openssl rand -base64 32`; keep it stable per environment.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Local only: integration tests run against this database.
DATABASE_URL_TEST=postgres://vm_portal:change-me-local@db:5432/vm_portal_test
