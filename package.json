{
  "name": "vm-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:scripts",
    "start": "next start",
    "lint": "eslint",
    "build:scripts": "node scripts/build-scripts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "stack:local": "docker compose --env-file .env.local -f compose.yml -f compose.local.yml up --build --renew-anon-volumes",
    "stack:smoke": "docker compose --env-file .env.local -f compose.yml -f compose.release.yml -f compose.smoke.yml up --build",
    "stack:down": "docker compose --env-file .env.local -f compose.yml -f compose.local.yml -f compose.release.yml -f compose.smoke.yml down",
    "local:migrate": "docker compose --env-file .env.local -f compose.yml -f compose.local.yml exec app npm run db:migrate",
    "local:test": "docker compose --env-file .env.local -f compose.yml -f compose.local.yml exec app npm test"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "geist": "1.7.2",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
